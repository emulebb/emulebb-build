ARG BASE_IMAGE=docker.io/library/alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a
FROM ${BASE_IMAGE}
RUN if command -v apk >/dev/null; then \
      apk add --no-cache python3 tar zstd ca-certificates tzdata; \
    else \
      apt-get update && apt-get install -y --no-install-recommends \
        python3 tar zstd ca-certificates tzdata && rm -rf /var/lib/apt/lists/*; \
    fi
ENV PYTHONDONTWRITEBYTECODE=1
